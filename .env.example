# ==============================================================================
# PTaaS Cloud Platform — Environment Configuration Example (Public Demo)
# Copy this file to `.env.local` if you need overrides locally.
# NEVER commit real secrets, tokens, or credentials.
# ==============================================================================

# Demo Mode (recommended: true; missing values safely default to true)
# Controls client-side demo badges, simulated shell, static desktop preview,
# and fake demo-only login credentials.
NEXT_PUBLIC_DEMO_MODE=true

# Server-side Demo Mode guard (optional; defaults to true when unset)
DEMO_MODE=true

# Next.js server port (optional; default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Local Gateway Only (see gateway/README.md — NOT used by Vercel deployment)
# ------------------------------------------------------------------------------
# DESKTOP_BACKEND=
# GUACD_HOST=127.0.0.1
# GUACD_PORT=4822
