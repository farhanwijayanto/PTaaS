# ==============================================================================
# PTaaS Cloud Platform — Production Real-Docker Mode (.env.prod.example)
# Copy to `.env.prod` on your Docker VPS and replace all placeholder secrets.
# NEVER commit `.env.prod` to Git.
# ==============================================================================

# Public WebSocket URL pointing to `ptaas-guac-ws` (port 8080 behind TLS reverse proxy / Cloudflare Tunnel)
NEXT_PUBLIC_GUAC_WS_URL=wss://guac.example.com

# Golden Kali image pinned by tag or @sha256 digest (NEVER `:latest`)
# Build once with: docker build -t ptaas/kali:2024.3 images/kali
KALI_IMAGE=ptaas/kali:2024.3

# Ports inside the golden Kali image (images/kali/Dockerfile uses 3389 RDP + 2222 SSH)
PTAAS_RDP_PORT=3389
PTAAS_SSH_PORT=2222

# Container memory overcommit ratio (2.0 recommended for lab VMs)
PTAAS_MEMORY_OVERCOMMIT_RATIO=2.0

# REQUIRED SECRETS — generate with `openssl rand -hex 16` (32 chars)
# GUAC_SECRET_KEY MUST be exactly 32 characters (AES-256-CBC shared between web & guac-ws)
GUAC_SECRET_KEY=replace_with_32_char_hex_secret0
VM_SECRET_KEY=replace_with_random_32_plus_char_vm_encryption_key
AUTH_SECRET=replace_with_random_32_plus_char_auth_session_secret
ADMIN_INITIAL_PASSWORD=replace_with_strong_admin_password
